NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/revenue-intelligence
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=24h
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/oauth/linkedin/callback

# Microsoft Foundry model deployment used for the first decision brief. Leave blank until the
# deployment exists; the brief then reports "not configured" instead of failing onboarding.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_MODEL=
# Use exactly one of these: a resource key, or an Entra access token for https://ai.azure.com/.default
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ACCESS_TOKEN=
# Optional overrides
AZURE_FOUNDRY_TIMEOUT_MS=60000
AZURE_FOUNDRY_CHAT_URL=

# Published discovery interview agent (Responses protocol). Its endpoint requires
# Microsoft Entra authentication, not an API key. In Azure, enable a managed
# identity on this API and grant it Foundry Agent Consumer on the project.
AZURE_FOUNDRY_INTERVIEW_AGENT_ENDPOINT=https://stratvedaos-v1-resource.services.ai.azure.com/api/projects/stratvedaos-v1/agents/discovery-agent/endpoint/protocols/openai/responses
# AZURE_FOUNDRY_ACCESS_TOKEN above can supply a short-lived local Entra token.

# Optional post-interview company-data stage. In Azure the API uses its managed
# identity; locally set AZURE_DATA_INTAKE_ACCESS_TOKEN or use the Azure CLI token.
AZURE_STORAGE_ACCOUNT=excelfilereader661745
AZURE_STORAGE_QUARANTINE_CONTAINER=data-intake-quarantine
AZURE_STORAGE_CLEAN_CONTAINER=data-intake-clean
AZURE_STORAGE_SAS_URL=
AZURE_DATA_INTAKE_ACCESS_TOKEN=
DATA_INTAKE_POLL_INTERVAL_MS=3000
DATA_INTAKE_SCAN_TIMEOUT_MS=600000

# Document Intelligence (prebuilt-read).
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://doc-revops-dev.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_MS=60000

# Prompt Shields on the existing Content Safety resource.
AZURE_CONTENT_SAFETY_ENDPOINT=https://stratvedaos-v1-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=

# Data Agent (A2A v1.0) and Master Agent (Responses).
AZURE_DATA_AGENT_A2A_ENDPOINT=https://stratvedaos-v1-resource.services.ai.azure.com/api/projects/stratvedaos-v1/agents/data-analyst-agent/endpoint/protocols/a2a
AZURE_MASTER_AGENT_ENDPOINT=https://stratvedaos-v1-resource.services.ai.azure.com/api/projects/stratvedaos-v1/agents/main-agent/endpoint/protocols/openai/responses
AZURE_DATA_AGENT_TIMEOUT_MS=180000
AZURE_MASTER_AGENT_TIMEOUT_MS=90000
